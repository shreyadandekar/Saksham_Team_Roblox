# ──────────────────────────────────────────────
#  Server environment variables – EXAMPLE ONLY
#  Copy this file to .env and fill in real values
#  Never commit .env to version control
# ──────────────────────────────────────────────

NODE_ENV=development

# Express
PORT=4000

# PostgreSQL (Prisma DATABASE_URL format)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/fdr_sentinel?schema=public

# CORS allowed origin (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
