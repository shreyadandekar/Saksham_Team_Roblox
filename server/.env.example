NODE_ENV=development

# Express
PORT=4000

# PostgreSQL (Prisma DATABASE_URL format)
# Local PostgreSQL format: postgresql://USER:PASSWORD@localhost:5432/fdr_sentinel?schema=public
# Supabase pooled format:  postgresql://postgres.xxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/fdr_sentinel?schema=public

# CORS allowed origin (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# JWT Secret (MUST be at least 32 characters long in production)
# Generate a secure 64-char hex secret in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=development_fdr_sentinel_jwt_secret_must_be_at_least_32_characters_long

# ── Supabase Storage (required for Milestone 4 document upload) ────────────
# Find these in your Supabase project dashboard → Project Settings → API
# SUPABASE_URL: "Project URL" (e.g. https://xxxxxxxxxxxx.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: "service_role" secret key (NOT the anon key)
# NEVER commit real values to version control.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Name of the private Supabase Storage bucket for FDR documents.
# Create this bucket in Supabase Storage dashboard; keep it PRIVATE (no public access).
SUPABASE_STORAGE_BUCKET=fdr-documents

# Maximum allowed upload file size in bytes (default: 10485760 = 10 MB)
MAX_UPLOAD_BYTES=10485760
